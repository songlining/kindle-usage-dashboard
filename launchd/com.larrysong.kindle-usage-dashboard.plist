<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.larrysong.kindle-usage-dashboard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/larry.song/bin/kindle-usage-render-and-push.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/kindle-usage-dashboard.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/kindle-usage-dashboard.err.log</string>
</dict>
</plist>
